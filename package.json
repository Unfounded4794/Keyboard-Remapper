{
  "name": "keystone-remapper",
  "version": "0.8.0",
  "private": true,
  "description": "Offline keyboard workbench for VIA, Vial and ZMK Studio",
  "author": "Keystone contributors",
  "homepage": "https://github.com/Unfounded4794/Keyboard-Remapper",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "vite --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:ui": "playwright test",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never",
    "dist:linux": "npm run dist -- --linux --x64 --arm64",
    "dist:mac": "npm run dist -- --mac --x64 --arm64",
    "test:packaged": "node scripts/verify-packaged.mjs",
    "test:desktop": "node scripts/smoke-desktop.mjs"
  },
  "dependencies": {
    "@zmkfirmware/zmk-studio-ts-client": "0.0.18",
    "lucide-react": "^0.468.0",
    "lzma": "^2.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xz-decompress": "^0.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/w3c-web-hid": "^1.0.6",
    "@types/w3c-web-serial": "^1.0.8",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.12",
    "prettier": "^3.9.10",
    "run-script-os": "^1.1.6",
    "typescript": "~5.7.3",
    "vite": "^6.4.0",
    "vitest": "^5.0.4"
  },
  "build": {
    "appId": "dev.keystone.remapper",
    "productName": "Keystone",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "notarize": false,
      "category": "public.app-category.utilities",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Keystone contributors <Unfounded4794@users.noreply.github.com>",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
